{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-job-agent.local/schemas/question_bank_item.schema.json",
  "title": "QuestionBankItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "locale",
    "domain",
    "question_type",
    "difficulty",
    "skill_tags",
    "question_text",
    "reference_answer",
    "scoring_rubric",
    "followup_suggestions",
    "embedding_text",
    "source",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-\\.]{5,80}$"
    },
    "locale": {
      "type": "string",
      "enum": ["zh-CN"]
    },
    "domain": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "question_type": {
      "type": "string",
      "enum": ["skill", "project_deep_dive", "scenario", "foundation", "followup", "behavioral"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "skill_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "question_text": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1000
    },
    "reference_answer": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4000
    },
    "scoring_rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "points", "excellent_signal", "weak_signal"],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "points": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "excellent_signal": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "weak_signal": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          }
        }
      }
    },
    "followup_suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "embedding_text": {
      "type": "string",
      "minLength": 10,
      "maxLength": 3000
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["original", "course_note", "book_note", "interview_experience", "web_summary"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}


# ai-job-AGENT local development settings

APP_NAME=ai-job-AGENT
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:15173","http://127.0.0.1:15173"]

# PostgreSQL connection used by scripts/import_question_bank.py --write-db.
DATABASE_URL=postgresql://ai_job_agent:ai_job_agent@localhost:5432/ai_job_agent
BACKEND_DATABASE_URL=postgresql+psycopg://ai_job_agent:ai_job_agent@localhost:5432/ai_job_agent
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ai_job_agent
MINIO_SECRET_KEY=ai_job_agent_dev_secret

# Local auth settings. Do not use this default secret in production.
JWT_SECRET_KEY=local-dev-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESUME_STORAGE_DIR=../data/resumes

# OpenAI-compatible embeddings endpoint used by scripts/import_question_bank.py --with-embeddings.
# Do not put real API keys in committed files.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace_me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=60
